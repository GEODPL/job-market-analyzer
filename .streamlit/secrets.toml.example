# Αντίγραψε αυτό το περιεχόμενο στο Streamlit Cloud:
# App -> Settings -> Secrets   (ή τοπικά σε .streamlit/secrets.toml)

SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "your-supabase-key"
OPENAI_API_KEY = "sk-..."

# Για τους λογαριασμούς (username + κωδικός) ο πίνακας app_users είναι κλειδωμένος με RLS,
# άρα χρειάζεται το service_role key (Supabase -> Project Settings -> API).
# Μένει μόνο στα Secrets του server, ποτέ στο GitHub.
SUPABASE_SERVICE_KEY = "your-service-role-key"

# Προαιρετικό: αν το ορίσεις, η εγγραφή νέων χρηστών ζητά και αυτόν τον κωδικό πρόσκλησης.
# Χωρίς αυτό, όποιος έχει το link μπορεί να φτιάξει λογαριασμό και να χρησιμοποιεί το OpenAI key σου.
# INVITE_CODE = "κάτι-δικό-σου"
